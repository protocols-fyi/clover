{
  "name": "@protocols-fyi/clover",
  "version": "2.8.0",
  "description": "Server routes enhanced with Zod and OpenAPI schemas",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "require": "./dist/index.cjs"
    }
  },
  "homepage": "https://protocols-fyi.github.io/clover/",
  "repository": {
    "type": "git",
    "url": "https://github.com/protocols-fyi/clover.git",
    "directory": "packages/clover"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup --config ./tsup.config.ts",
    "dev": "pnpm run build --watch",
    "prepublishOnly": "pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lodash.merge": "^4.6.2",
    "openapi3-ts": "^4.5.0",
    "path-to-regexp": "^6.3.0",
    "zod": "^4.3.6",
    "zod-openapi": "^5.4.6"
  },
  "devDependencies": {
    "@types/lodash.merge": "^4.6.9",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
